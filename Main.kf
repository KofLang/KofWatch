application {
    onStart { log.info("kofwatch subindo") }
    onShutdown { log.info("kofwatch saindo") }
}

Long parametroLong(String chave, Long padrao) {
    var bruto = query(chave)
    if (bruto == null || bruto == "") { return padrao }
    return toLongOrThrow(bruto)
}

Bool longValido(String bruto) {
    try {
        bruto.toLong()
        return true
    } catch (String e) {
        return false
    }
}

String? erroDeQuery(String chave) {
    var bruto = query(chave)
    if (bruto == null || bruto == "" || longValido(bruto)) { return null }
    return "parâmetro " + chave + " inválido: " + bruto
}

String? erroDeIngestao(MetricaIn entrada) {
    if (entrada.name == null || entrada.name.trim() == "") { return "name é obrigatório" }
    if (entrada.valor == null || entrada.valor.trim() == "") { return "valor é obrigatório" }
    if (entrada.ts == null || entrada.ts.trim() == "") { return "ts é obrigatório" }
    try {
        entrada.valor.toDouble()
    } catch (String e) {
        return "valor deve ser numérico: " + entrada.valor
    }
    try {
        entrada.ts.toLong()
    } catch (String e) {
        return "ts deve ser inteiro: " + entrada.ts
    }
    if (entrada.ts.toLong() < 0) { return "ts não pode ser negativo" }
    return null
}

String? erroDeLabels(String? bruto) {
    if (bruto == null || bruto == "") { return null }
    try {
        canonicalLabels(bruto)
        return null
    } catch (String e) {
        return e
    }
}

main() {
    var app = web.app()
    var db = db.connect(config.str("db.url", "jdbc:h2:./data/kofwatch;AUTO_SERVER=TRUE"))
    storageInit(db)
    var inicio = time.now()

    app.get("/api/health") {
        headerSet("Access-Control-Allow-Origin", "*")
        return observability.health()
    }

    app.get("/api/info") {
        headerSet("Access-Control-Allow-Origin", "*")
        return json.encode(InfoOut("kofwatch", "0.1.0", time.now() - inicio, totalAmostras(db)))
    }

    app.get("/api/dashboards") {
        headerSet("Access-Control-Allow-Origin", "*")
        var todos = carregarManifestos(config.str("dashboards.dir", "dashboards"))
        return json.encode(resumirManifestos(todos))
    }

    app.get("/api/dashboard/:name") {
        headerSet("Access-Control-Allow-Origin", "*")
        var nome = param("name")
        var erroNome = erroDeNome(nome)
        if (erroNome != null) {
            return status(400, json.encode(ErroOut(erroNome)))
        }
        var d = buscarManifesto(config.str("dashboards.dir", "dashboards"), nome)
        if (d != null) {
            return json.encode(d)
        }
        return status(404, json.encode(ErroOut("dashboard não encontrado: " + nome)))
    }

    app.get("/api/dashboard/:name/panels") {
        headerSet("Access-Control-Allow-Origin", "*")
        var nome = param("name")
        var erroNome = erroDeNome(nome)
        if (erroNome != null) {
            return status(400, json.encode(ErroOut(erroNome)))
        }
        var d = buscarManifesto(config.str("dashboards.dir", "dashboards"), nome)
        if (d != null) {
            return json.encode(d.panels)
        }
        return status(404, json.encode(ErroOut("dashboard não encontrado: " + nome)))
    }

    app.post("/api/metrics") {
        var entrada: MetricaIn?
        try {
            entrada = json.decode<MetricaIn>(body())
        } catch (Exception e) {
            return status(400, json.encode(ErroOut("corpo inválido: JSON malformado")))
        }
        if (entrada != null) {
            var erro = erroDeIngestao(entrada)
            if (erro != null) {
                return status(400, json.encode(ErroOut(erro)))
            }
            var ts = entrada.ts.toLong()
            if (ts == 0) { ts = time.now() }
            var id = registrar(db, entrada.name, entrada.valor.toDouble(), ts, entrada.labels)
            log.info("amostra " + entrada.name + " id=" + id)
            return status(201, json.encode(IngestOut(true, id)))
        }
        return status(400, json.encode(ErroOut("corpo inválido: JSON malformado")))
    }

    app.get("/api/metrics") {
        headerSet("Access-Control-Allow-Origin", "*")
        return json.encode(listarSeries(db))
    }

    app.get("/api/query/:name") {
        headerSet("Access-Control-Allow-Origin", "*")
        var erroFrom = erroDeQuery("from")
        if (erroFrom != null) { return status(400, json.encode(ErroOut(erroFrom))) }
        var erroTo = erroDeQuery("to")
        if (erroTo != null) { return status(400, json.encode(ErroOut(erroTo))) }
        var erroLabels = erroDeLabels(query("labels"))
        if (erroLabels != null) { return status(400, json.encode(ErroOut(erroLabels))) }
        var metrica = param("name")
        var de = parametroLong("from", 0)
        var ate = parametroLong("to", time.now())
        log.info("consulta " + metrica)
        return json.encode(consultarAmostras(db, metrica, de, ate, canonicalLabels(query("labels"))))
    }

    app.get("/api/aggregate/:name") {
        headerSet("Access-Control-Allow-Origin", "*")
        var erroFn = erroDeQuery("windowMs")
        if (erroFn != null) { return status(400, json.encode(ErroOut(erroFn))) }
        var nome = query("fn")
        var janela = parametroLong("windowMs", 86400000)
        var ate = time.now()
        if (nome != "avg" && nome != "sum" && nome != "min" && nome != "max" && nome != "count") {
            return status(400, json.encode(ErroOut("agregação inválida: " + nome)))
        }
        return json.encode(AggOut(nome, agregar(db, param("name"), nome, ate - janela, ate)))
    }

    scheduler.every(config.int("retention.checkMs", 3600000)) {
        log.info("retenção: " + retencao(db, time.now() - config.int("retention.ms", 86400000)) + " amostras removidas")
    }

    app.listen(config.int("server.port", 8080))
}
