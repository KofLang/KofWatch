record SerieOut(String name, String labels, Double valor, Long ts, Long count)

record AmostraIn(Long ts, Double valor, String labels)

List<List<String> > linhasDe(List<SerieOut> series) {
    var linhas = listOf<List<String> >()
    for (var s in series) {
        var linha = listOf<String>()
        linha.add(s.name)
        linha.add(s.labels)
        linha.add(s.valor.toString())
        linha.add(s.count.toString())
        linhas.add(linha)
    }
    return linhas
}

List<String> nomesDe(List<SerieOut> series) {
    var nomes = listOf<String>()
    for (var s in series) {
        nomes.add(s.name)
    }
    return nomes
}

List<Double> valoresDe(List<AmostraIn> amostras) {
    var valores = listOf<Double>()
    for (var a in amostras) {
        valores.add(a.valor)
    }
    return valores
}

String resumo(List<Double> pontos) {
    if (pontos.size == 0) {
        return "sem amostras"
    }
    var minimo = pontos.get(0)
    var maximo = minimo
    for (var p in pontos) {
        if (p < minimo) {
            minimo = p
        }
        if (p > maximo) {
            maximo = p
        }
    }
    return minimo.toString() + " a " + maximo.toString()
}

List<List<Double> > traco(List<Double> pontos) {
    var coordenadas = listOf<List<Double> >()
    if (pontos.size < 2) {
        return coordenadas
    }
    var largura = 508.0
    var altura = 240.0
    var margem = 24.0
    var minimo = pontos.get(0)
    var maximo = minimo
    for (var p in pontos) {
        if (p < minimo) {
            minimo = p
        }
        if (p > maximo) {
            maximo = p
        }
    }
    var faixa = maximo - minimo
    if (faixa <= 0.0) {
        faixa = 1.0
    }
    var passo = (largura - margem * 2.0) / (pontos.size - 1)
    var i = 0
    while (i < pontos.size) {
        var par = listOf<Double>()
        par.add(margem + i * passo)
        par.add(altura - margem - ((pontos.get(i) - minimo) / faixa) * (altura - margem * 2.0))
        coordenadas.add(par)
        i = i + 1
    }
    return coordenadas
}

main() {
    var base = "http://localhost:8080"
    var nomes = listOf<String>()
    var historico = listOf<List<Double> >()
    var pulso = 0

    var janela = Window("KofWatch")
    janela.theme = Theme.dark()
    janela.size(560, 720)

    var titulo = Label("KofWatch")
    titulo.fontSize = 22
    titulo.bold = true
    titulo.color = Palette.cyan

    var subtitulo = Label("observador de metricas")
    subtitulo.color = Palette.gray

    var status = Label("carregando " + base + " ...")
    status.color = Palette.gray

    var cabecalho = Row(listOf(titulo, subtitulo))

    var rotuloTabela = Label("series")
    rotuloTabela.fontSize = 13
    rotuloTabela.bold = true

    var tabela = Table(listOf("metrica", "labels", "ultimo", "amostras"), listOf<List<String> >())

    var rotuloGrafico = Label("historico")
    rotuloGrafico.fontSize = 13
    rotuloGrafico.bold = true

    var seletor = Select(listOf("..."))
    var rotuloSerie = Label("")
    rotuloSerie.color = Palette.cyan

    var botaoAtualizar = Button("atualizar")

    var canvas = Canvas(508, 240)

    var painel = View(Style(Theme.dark().background(), Theme.dark().text(), 16, 10))
    painel.bind(Column(listOf(cabecalho, status, Hr(), rotuloTabela, tabela, Hr(), botaoAtualizar, seletor, rotuloSerie, canvas)))
    janela.bind(painel)

    try {
        var bruto = await(spawn(() -> http.get(base + "/api/metrics")))
        var series = json.decode<List<SerieOut>>(bruto)
        nomes = nomesDe(series)
        tabela.setRows(linhasDe(series))
        seletor.setOptions(nomes)

        var i = 0
        while (i < series.size) {
            var nome = series.get(i).name
            var brutoSerie = await(spawn(() -> http.get(base + "/api/query/" + nome)))
            var amostras = json.decode<List<AmostraIn>>(brutoSerie)
            historico.add(valoresDe(amostras))
            i = i + 1
        }

        status.text = nomes.size.toString() + " series ativas em " + base
        status.color = Palette.green

        if (nomes.size > 0 && historico.size > 0) {
            seletor.setSelected(0)
            rotuloSerie.text = nomes.get(0) + ": " + resumo(historico.get(0))
            var tracado = traco(historico.get(0))
            canvas.clearRect(0.0, 0.0, 508.0, 240.0)
            canvas.setStroke(Palette.gray)
            canvas.setLineWidth(1)
            var g = 0
            while (g < 4) {
                var y = 24.0 + g * 64.0
                canvas.beginPath()
                canvas.moveTo(24.0, y)
                canvas.lineTo(484.0, y)
                canvas.stroke()
                g = g + 1
            }
            if (tracado.size > 1) {
                canvas.setFill(Color.rgba(0, 200, 255, 40))
                canvas.beginPath()
                canvas.moveTo(tracado.get(0).get(0), 216.0)
                var k = 0
                while (k < tracado.size) {
                    canvas.lineTo(tracado.get(k).get(0), tracado.get(k).get(1))
                    k = k + 1
                }
                canvas.lineTo(tracado.get(tracado.size - 1).get(0), 216.0)
                canvas.closePath()
                canvas.fill()
                canvas.setStroke(Palette.cyan)
                canvas.setLineWidth(2)
                canvas.beginPath()
                canvas.moveTo(tracado.get(0).get(0), tracado.get(0).get(1))
                var k2 = 1
                while (k2 < tracado.size) {
                    canvas.lineTo(tracado.get(k2).get(0), tracado.get(k2).get(1))
                    k2 = k2 + 1
                }
                canvas.stroke()
            }
        }
    } catch (String e) {
        status.text = "backend indisponivel: " + e
        status.color = Palette.red
    }

    time.interval(3000, (e: Event) -> {
        pulso = pulso + 1
        spawn {
            var bruto = await(http.get(base + "/api/metrics"))
            var series = json.decode<List<SerieOut>>(bruto)
            var novosNomes = nomesDe(series)
            var novoHistorico = listOf<List<Double> >()
            var i = 0
            while (i < series.size) {
                var nome = series.get(i).name
                var brutoSerie = await(http.get(base + "/api/query/" + nome))
                var amostras = json.decode<List<AmostraIn>>(brutoSerie)
                novoHistorico.add(valoresDe(amostras))
                i = i + 1
            }
            nomes = novosNomes
            historico = novoHistorico
            tabela.setRows(linhasDe(series))
            seletor.setOptions(novosNomes)
            status.text = nomes.size.toString() + " series ativas em " + base + " (pulso " + pulso.toString() + ")"
            status.color = Palette.green
            if (nomes.size > 0 && historico.size > 0) {
                var indice = seletor.selected()
                if (indice < 0 || indice >= historico.size) {
                    indice = 0
                }
                seletor.setSelected(indice)
                rotuloSerie.text = nomes.get(indice) + ": " + resumo(historico.get(indice))
                var tracado = traco(historico.get(indice))
                canvas.clearRect(0.0, 0.0, 508.0, 240.0)
                canvas.setStroke(Palette.gray)
                canvas.setLineWidth(1)
                var g = 0
                while (g < 4) {
                    var y = 24.0 + g * 64.0
                    canvas.beginPath()
                    canvas.moveTo(24.0, y)
                    canvas.lineTo(484.0, y)
                    canvas.stroke()
                    g = g + 1
                }
                if (tracado.size > 1) {
                    canvas.setFill(Color.rgba(0, 200, 255, 40))
                    canvas.beginPath()
                    canvas.moveTo(tracado.get(0).get(0), 216.0)
                    var k = 0
                    while (k < tracado.size) {
                        canvas.lineTo(tracado.get(k).get(0), tracado.get(k).get(1))
                        k = k + 1
                    }
                    canvas.lineTo(tracado.get(tracado.size - 1).get(0), 216.0)
                    canvas.closePath()
                    canvas.fill()
                    canvas.setStroke(Palette.cyan)
                    canvas.setLineWidth(2)
                    canvas.beginPath()
                    canvas.moveTo(tracado.get(0).get(0), tracado.get(0).get(1))
                    var k2 = 1
                    while (k2 < tracado.size) {
                        canvas.lineTo(tracado.get(k2).get(0), tracado.get(k2).get(1))
                        k2 = k2 + 1
                    }
                    canvas.stroke()
                }
            }
        }
    })

    seletor.on("change", (e: Event) -> {
        var indice = seletor.selected()
        if (indice < 0 || indice >= historico.size) {
            return
        }
        var pontos = historico.get(indice)
        rotuloSerie.text = nomes.get(indice) + ": " + resumo(pontos)
        var tracado = traco(pontos)
        canvas.clearRect(0.0, 0.0, 508.0, 240.0)
        canvas.setStroke(Palette.gray)
        canvas.setLineWidth(1)
        var g = 0
        while (g < 4) {
            var y = 24.0 + g * 64.0
            canvas.beginPath()
            canvas.moveTo(24.0, y)
            canvas.lineTo(484.0, y)
            canvas.stroke()
            g = g + 1
        }
        if (tracado.size > 1) {
            canvas.setFill(Color.rgba(0, 200, 255, 40))
            canvas.beginPath()
            canvas.moveTo(tracado.get(0).get(0), 216.0)
            var k = 0
            while (k < tracado.size) {
                canvas.lineTo(tracado.get(k).get(0), tracado.get(k).get(1))
                k = k + 1
            }
            canvas.lineTo(tracado.get(tracado.size - 1).get(0), 216.0)
            canvas.closePath()
            canvas.fill()
            canvas.setStroke(Palette.cyan)
            canvas.setLineWidth(2)
            canvas.beginPath()
            canvas.moveTo(tracado.get(0).get(0), tracado.get(0).get(1))
            var k2 = 1
            while (k2 < tracado.size) {
                canvas.lineTo(tracado.get(k2).get(0), tracado.get(k2).get(1))
                k2 = k2 + 1
            }
            canvas.stroke()
        }
    })

    botaoAtualizar.on("click", (e: Event) -> {
        status.text = "atualizando ..."
        status.color = Palette.gray
        spawn {
            var bruto = await(http.get(base + "/api/metrics"))
            var series = json.decode<List<SerieOut>>(bruto)
            var novosNomes = nomesDe(series)
            var novoHistorico = listOf<List<Double> >()
            var i = 0
            while (i < series.size) {
                var nome = series.get(i).name
                var brutoSerie = await(http.get(base + "/api/query/" + nome))
                var amostras = json.decode<List<AmostraIn>>(brutoSerie)
                novoHistorico.add(valoresDe(amostras))
                i = i + 1
            }
            nomes = novosNomes
            historico = novoHistorico
            tabela.setRows(linhasDe(series))
            seletor.setOptions(novosNomes)
            status.text = nomes.size.toString() + " series ativas em " + base
            status.color = Palette.green
        }
    })

    spawn {
        var bruto = await(http.get(base + "/api/metrics"))
        var series = json.decode<List<SerieOut>>(bruto)
        nomes = nomesDe(series)
        tabela.setRows(linhasDe(series))
        seletor.setOptions(nomes)

        var i = 0
        while (i < series.size) {
            var nome = series.get(i).name
            var brutoSerie = await(http.get(base + "/api/query/" + nome))
            var amostras = json.decode<List<AmostraIn>>(brutoSerie)
            historico.add(valoresDe(amostras))
            i = i + 1
        }

        status.text = nomes.size.toString() + " series ativas em " + base
        status.color = Palette.green

        if (nomes.size > 0 && historico.size > 0) {
            seletor.setSelected(0)
            rotuloSerie.text = nomes.get(0) + ": " + resumo(historico.get(0))
            var tracado = traco(historico.get(0))
            canvas.clearRect(0.0, 0.0, 508.0, 240.0)
            canvas.setStroke(Palette.gray)
            canvas.setLineWidth(1)
            var g = 0
            while (g < 4) {
                var y = 24.0 + g * 64.0
                canvas.beginPath()
                canvas.moveTo(24.0, y)
                canvas.lineTo(484.0, y)
                canvas.stroke()
                g = g + 1
            }
            if (tracado.size > 1) {
                canvas.setFill(Color.rgba(0, 200, 255, 40))
                canvas.beginPath()
                canvas.moveTo(tracado.get(0).get(0), 216.0)
                var k = 0
                while (k < tracado.size) {
                    canvas.lineTo(tracado.get(k).get(0), tracado.get(k).get(1))
                    k = k + 1
                }
                canvas.lineTo(tracado.get(tracado.size - 1).get(0), 216.0)
                canvas.closePath()
                canvas.fill()
                canvas.setStroke(Palette.cyan)
                canvas.setLineWidth(2)
                canvas.beginPath()
                canvas.moveTo(tracado.get(0).get(0), tracado.get(0).get(1))
                var k2 = 1
                while (k2 < tracado.size) {
                    canvas.lineTo(tracado.get(k2).get(0), tracado.get(k2).get(1))
                    k2 = k2 + 1
                }
                canvas.stroke()
            }
        }
    }

    janela.show()
}
