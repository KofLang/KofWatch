record SerieOut(String name, String labels, Double valor, Long ts, Long count)

record AmostraIn(Long ts, Double valor, String labels)

record AggOut(String funcao, Double valor)

record PainelFront(String title, String type, String metric, String fnc, String unit, Long fromMs, Long windowMs)

record DashboardFront(String name, String title, Long refreshMs, List<PainelFront> panels)

record DashboardResumoFront(String name, String title, Long panels, String erro)

record AlertaEstadoFront(String name, String title, String severidade, String estado, Double valor, String operador, Double threshold, Long lastEvaluation, String erro, Long ackedMs)

List<Double> valoresDeTexto(String bruto) {
    var valores = listOf<Double>()
    if (bruto == null || bruto == "") {
        return valores
    }
    var amostras = json.decode<List<AmostraIn>>(bruto)
    for (var a in amostras) {
        valores.add(a.valor())
    }
    return valores
}

Double valorDeGaugeTexto(String bruto) {
    if (bruto == null || bruto == "") {
        return 0.0
    }
    var agg = json.decode<AggOut>(bruto)
    return agg.valor()
}

String comDuasCasas(Double v) {
    var escalado = v * 100.0
    var inteiro = 0.0
    if (escalado >= 0.0) {
        inteiro = escalado - (escalado % 1.0)
    } else {
        inteiro = escalado - (escalado % 1.0) + 1.0
    }
    return (inteiro / 100.0).toString()
}

String textoDeValor(Double valor, String unidade) {
    var corpo = comDuasCasas(valor)
    if (unidade == "") {
        return corpo
    }
    return corpo + " " + unidade
}

List<List<Double> > traco(List<Double> pontos) {
    var coordenadas = listOf<List<Double> >()
    if (pontos.size < 2) {
        return coordenadas
    }
    var largura = 508.0
    var altura = 200.0
    var margem = 24.0
    var minimo = pontos.get(0)
    var maximo = minimo
    for (var p in pontos) {
        if (p < minimo) {
            minimo = p
        }
        if (p > maximo) {
            maximo = p
        }
    }
    var faixa = maximo - minimo
    if (faixa <= 0.0) {
        faixa = 1.0
    }
    var passo = (largura - margem * 2.0) / (pontos.size - 1)
    var i = 0
    var par = listOf<Double>()
    while (i < pontos.size) {
        par = listOf<Double>()
        par.add(margem + i * passo)
        par.add(altura - margem - ((pontos.get(i) - minimo) / faixa) * (altura - margem * 2.0))
        coordenadas.add(par)
        i = i + 1
    }
    return coordenadas
}

String resumoDe(List<Double> pontos) {
    if (pontos.size == 0) {
        return "sem amostras"
    }
    var minimo = pontos.get(0)
    var maximo = minimo
    for (var p in pontos) {
        if (p < minimo) {
            minimo = p
        }
        if (p > maximo) {
            maximo = p
        }
    }
    return comDuasCasas(minimo) + " a " + comDuasCasas(maximo)
}

String formatoDe(List<Double> pontos) {
    if (pontos.size == 0) {
        return "sem amostras"
    }
    if (pontos.size == 1) {
        return "1 amostra"
    }
    return pontos.size.toString() + " amostras"
}

Column celulaPainel(PainelFront p, List<Double> pontos) {
    var rotulo = Label(p.title())    rotulo.fontSize = 13
    rotulo.bold = true
    var tipo = Label("(" + p.type() + " · " + p.metric() + ")")
    tipo.color = Palette.gray
    tipo.fontSize = 11
    var c = Canvas(508, 200)
    c.setStroke(Palette.gray)
    c.setLineWidth(1)
    var estaVazio = pontos.size == 0
    if (p.type() == "gauge") {
        var valor = 0.0
        if (pontos.size > 0) {
            valor = pontos.get(0)
        }
        var fracao = valor
        if (fracao < 0.0) {
            fracao = 0.0
        }
        if (fracao > 1.0) {
            fracao = 1.0
        }
        c.setStroke(Palette.gray)
        c.setLineWidth(12)
        c.beginPath()
        c.arc(254.0, 130.0, 80.0, 3.14159, 6.28318)
        c.stroke()
        if (fracao > 0.0) {
            c.setStroke(Palette.cyan)
            c.beginPath()
            c.arc(254.0, 130.0, 80.0, 3.14159, 3.14159 + fracao * 3.14159)
            c.stroke()
        }
        c.setFill(Palette.cyan)
        c.fillText(textoDeValor(valor, p.unit()), 214.0, 138.0)
    } else if (p.type() == "timeseries") {
        var tracado = traco(pontos)
        var g = 0
        while (g < 4) {
            var y = 24.0 + g * 50.0
            c.beginPath()
            c.moveTo(24.0, y)
            c.lineTo(484.0, y)
            c.stroke()
            g = g + 1
        }
        if (tracado.size > 1) {
            c.setFill(Color.rgba(0, 200, 255, 40))
            c.beginPath()
            c.moveTo(tracado.get(0).get(0), 176.0)
            var k = 0
            while (k < tracado.size) {
                c.lineTo(tracado.get(k).get(0), tracado.get(k).get(1))
                k = k + 1
            }
            c.lineTo(tracado.get(tracado.size - 1).get(0), 176.0)
            c.closePath()
            c.fill()
            c.setStroke(Palette.cyan)
            c.setLineWidth(2)
            c.beginPath()
            c.moveTo(tracado.get(0).get(0), tracado.get(0).get(1))
            var k2 = 1
            while (k2 < tracado.size) {
                c.lineTo(tracado.get(k2).get(0), tracado.get(k2).get(1))
                k2 = k2 + 1
            }
            c.stroke()
        }
        c.setFill(Palette.gray)
        c.fillText(resumoDe(pontos), 24.0, 16.0)
    } else if (p.type() == "stat") {
        var valor = 0.0
        if (pontos.size > 0) {
            valor = pontos.get(0)
        }
        c.setStroke(Palette.cyan)
        c.setLineWidth(2)
        c.beginPath()
        c.moveTo(24.0, 176.0)
        c.lineTo(484.0, 176.0)
        c.stroke()
        c.setFill(Palette.cyan)
        c.fillText(textoDeValor(valor, p.unit()), 24.0, 140.0)
        var rotuloFn = Label(p.fnc() + " de " + p.metric())
        c.setFill(Palette.gray)
        c.fillText("agregado", 24.0, 108.0)
    } else {
        c.setFill(Palette.gray)
        c.fillText("Painel nao suportado: " + p.type(), 24.0, 16.0)
    }
    if (estaVazio) {
        tipo.text = "(sem dados · " + formatoDe(pontos) + ")"
    }
    var celula = Column(listOf(rotulo, tipo, c))
    return celula
}

Column colunaPaineis(List<PainelFront> paineis, List<List<Double> > dados) {
    var widgets = listOf<Component>()
    var i = 0
    var pontos = listOf<Double>()
    while (i < paineis.size) {
        pontos = listOf<Double>()
        if (i < dados.size) {
            pontos = dados.get(i)
        }
        widgets.add(celulaPainel(paineis.get(i), pontos))
        i = i + 1
    }
    if (widgets.size == 0) {
        widgets = listOf(Label("nenhum painel no manifesto"))
    }
    return Column(widgets)
}

Column celulaAlerta(AlertaEstadoFront a) {
    var rotulo = Label(a.title())
    rotulo.fontSize = 13
    rotulo.bold = true
    var detalhe = Label(a.name() + " · " + a.operador() + " " + a.threshold().toString() + " · " + a.severidade())
    detalhe.color = Palette.gray
    detalhe.fontSize = 11
    var medida = Label(a.estado())
    medida.fontSize = 16
    medida.bold = true
    if (a.estado() == "firing") {
        medida.color = Palette.red
    } else if (a.estado() == "pending") {
        medida.color = Palette.cyan
    } else if (a.estado() == "error") {
        medida.color = Palette.gray
    } else {
        medida.color = Palette.green
    }
    var texto = "valor atual " + a.valor().toString()
    if (a.erro() != "") {
        texto = texto + " · " + a.erro()
    }
    var sub = Label(texto)
    sub.color = Palette.gray
    sub.fontSize = 11
    if (a.ackedMs() > 0 && (a.estado() == "firing" || a.estado() == "pending")) {
        var ack = Label("reconhecido")
        ack.color = Palette.cyan
        ack.fontSize = 11
        return Column(listOf(rotulo, detalhe, medida, sub, ack))
    }
    return Column(listOf(rotulo, detalhe, medida, sub))
}

Column colunaAlertas(List<AlertaEstadoFront> alertas) {
    var widgets = listOf<Component>()
    var i = 0
    while (i < alertas.size) {
        widgets.add(celulaAlerta(alertas.get(i)))
        i = i + 1
    }
    if (widgets.size == 0) {
        widgets = listOf(Label("nenhum alerta declarado em alerts/"))
    }
    return Column(widgets)
}

String alvoDeAck(List<AlertaEstadoFront> estados) {
    var alvo = ""
    var i = 0
    while (i < estados.size) {
        var e = estados.get(i)
        if (e.estado() == "firing" || e.estado() == "pending") {
            alvo = e.name()
            i = estados.size
        }
        i = i + 1
    }
    return alvo
}

main() {
    var base = "http://localhost:8080"
    var nomesDash = listOf<String>()
    var paineis = listOf<PainelFront>()
    var dados = listOf<List<Double> >()
    var pulso = 0

    var janela = Window("KofWatch")
    janela.theme = Theme.dark()
    janela.size(560, 760)

    var titulo = Label("KofWatch")
    titulo.fontSize = 22
    titulo.bold = true
    titulo.color = Palette.cyan

    var subtitulo = Label("dashboards declarativos")
    subtitulo.color = Palette.gray

    var status = Label("carregando " + base + " ...")
    status.color = Palette.gray

    var cabecalho = Row(listOf(titulo, subtitulo))

    var rotuloDashboards = Label("dashboards")
    rotuloDashboards.fontSize = 13
    rotuloDashboards.bold = true

    var seletorDash = Select(listOf("..."))

    var botaoAtualizar = Button("atualizar")

    var rotuloPaineis = Label("paineis")
    rotuloPaineis.fontSize = 13
    rotuloPaineis.bold = true

    var zonaPaineis = View(Style(Theme.dark().background(), Theme.dark().text(), 8, 4))

    var rotuloAlertas = Label("alertas")
    rotuloAlertas.fontSize = 13
    rotuloAlertas.bold = true

    var zonaAlertas = View(Style(Theme.dark().background(), Theme.dark().text(), 8, 4))

    var estadosAlerta = listOf<AlertaEstadoFront>()
    var botaoAck = Button("nenhum alerta ativo")

    var atualizarBotaoAck = () -> {
        var alvo = alvoDeAck(estadosAlerta)
        if (alvo == "") {
            botaoAck.text = "nenhum alerta ativo"
        } else {
            botaoAck.text = "reconhecer " + alvo
        }
    }

    var colunas = listOf<Column>()

    var painelRaiz = View(Style(Theme.dark().background(), Theme.dark().text(), 16, 10))
    painelRaiz.bind(Column(listOf(cabecalho, status, Hr(), rotuloDashboards, seletorDash, botaoAtualizar, Hr(), rotuloPaineis, zonaPaineis, Hr(), rotuloAlertas, botaoAck, zonaAlertas)))
    janela.bind(painelRaiz)

    try {
        var bruto = await(spawn(() -> http.get(base + "/api/dashboards")))
        var resumos = json.decode<List<DashboardResumoFront>>(bruto)
        var nomes = listOf<String>()
        for (var r in resumos) {
            nomes.add(r.name())
        }
        nomesDash = nomes
        if (nomes.size == 0) {
            status.text = "nenhum dashboard declarado em dashboards/"
            status.color = Palette.red
        } else {
            seletorDash.setOptions(nomes)
            seletorDash.setSelected(0)

            var brutoDash = await(spawn(() -> http.get(base + "/api/dashboard/" + nomes.get(0))))
            if (brutoDash == null || brutoDash == "") {
                status.text = "dashboard nao encontrado: " + nomes.get(0)
                status.color = Palette.red
            } else {
                var dash = json.decode<DashboardFront>(brutoDash)
                var brutoPaineis = await(spawn(() -> http.get(base + "/api/dashboard/" + nomes.get(0) + "/panels")))
                if (brutoPaineis == null || brutoPaineis == "") {
                    paineis = listOf<PainelFront>()
                } else {
                    paineis = json.decode<List<PainelFront>>(brutoPaineis)
                }
                dados = listOf<List<Double> >()
                status.text = "dashboard " + dash.title() + " (pulso inicial)"
                status.color = Palette.green

                var nova = colunaPaineis(paineis, dados)
                zonaPaineis.bind(nova)
                colunas = listOf(nova)
            }
        }
    } catch (String e) {
        status.text = "backend indisponivel: " + e
        status.color = Palette.red
    }

    spawn {
        try {
            var brutoAlertas = await(http.get(base + "/api/alerts"))
            var estados = json.decode<List<AlertaEstadoFront>>(brutoAlertas)
            estadosAlerta = estados
            atualizarBotaoAck.run()
            zonaAlertas.bind(colunaAlertas(estados))
        } catch (String e) {
            zonaAlertas.bind(Column(listOf(Label("alertas indisponiveis: " + e))))
        }
    }

    spawn {
        var novoDados = listOf<List<Double> >()
        var i = 0
        while (i < paineis.size) {
            var p = paineis.get(i)
            if (p.type() == "stat") {
                var caminhoAgg = "/api/aggregate/" + p.metric() + "?fn=" + p.fnc() + "&windowMs=" + p.windowMs().toString()
                var brutoAgg = await(http.get(base + caminhoAgg))
                var um = listOf<Double>()
                um.add(valorDeGaugeTexto(brutoAgg))
                novoDados.add(um)
            } else if (p.type() == "gauge") {
                var brutoAgg = await(http.get(base + "/api/aggregate/" + p.metric() + "?fn=avg&windowMs=" + p.windowMs().toString()))
                var um = listOf<Double>()
                um.add(valorDeGaugeTexto(brutoAgg))
                novoDados.add(um)
            } else {
                var agora = time.now()
                var inicio = agora - p.fromMs()
                var brutoSerie = await(http.get(base + "/api/query/" + p.metric() + "?from=" + inicio.toString() + "&to=" + agora.toString()))
                novoDados.add(valoresDeTexto(brutoSerie))
            }
            i = i + 1
        }
        dados = novoDados

        var nova = colunaPaineis(paineis, dados)
        zonaPaineis.bind(nova)
        colunas = listOf(nova)

        status.text = status.text + " | atualizado"
        status.color = Palette.green
    }

    time.interval(3000, (e: Event) -> {
        spawn {
            var novoDados = listOf<List<Double> >()
            var i = 0
            while (i < paineis.size) {
                var p = paineis.get(i)
                if (p.type() == "stat") {
                    var caminhoAgg = "/api/aggregate/" + p.metric() + "?fn=" + p.fnc() + "&windowMs=" + p.windowMs().toString()
                    var brutoAgg = await(http.get(base + caminhoAgg))
                    var um = listOf<Double>()
                    um.add(valorDeGaugeTexto(brutoAgg))
                    novoDados.add(um)
                } else if (p.type() == "gauge") {
                    var brutoAgg = await(http.get(base + "/api/aggregate/" + p.metric() + "?fn=avg&windowMs=" + p.windowMs().toString()))
                    var um = listOf<Double>()
                    um.add(valorDeGaugeTexto(brutoAgg))
                    novoDados.add(um)
                } else {
                    var agora = time.now()
                    var inicio = agora - p.fromMs()
                    var brutoSerie = await(http.get(base + "/api/query/" + p.metric() + "?from=" + inicio.toString() + "&to=" + agora.toString()))
                    novoDados.add(valoresDeTexto(brutoSerie))
                }
                i = i + 1
            }
            dados = novoDados

            var novaPulso = colunaPaineis(paineis, dados)
            zonaPaineis.bind(novaPulso)
            colunas = listOf(novaPulso)

            try {
                var brutoAlertas = await(http.get(base + "/api/alerts"))
                var estados = json.decode<List<AlertaEstadoFront>>(brutoAlertas)
                estadosAlerta = estados
                atualizarBotaoAck.run()
                zonaAlertas.bind(colunaAlertas(estados))
            } catch (String e) {
                zonaAlertas.bind(Column(listOf(Label("alertas indisponiveis: " + e))))
            }

            status.text = "dashboard ativo | pulso " + (pulso + 1).toString()
            status.color = Palette.green
            pulso = pulso + 1
        }
    })

    seletorDash.on("change", (e: Event) -> {
        spawn {
            var indice = seletorDash.selected()
            if (indice >= 0 && indice < nomesDash.size) {
                var nome = nomesDash.get(indice)
                status.text = "carregando dashboard " + nome + " ..."
                status.color = Palette.gray
                var brutoDash = await(http.get(base + "/api/dashboard/" + nome))
                if (brutoDash == null || brutoDash == "") {
                    status.text = "dashboard nao encontrado: " + nome
                    status.color = Palette.red
                } else {
                    var dash = json.decode<DashboardFront>(brutoDash)
                    var brutoPaineis = await(http.get(base + "/api/dashboard/" + nome + "/panels"))
                    if (brutoPaineis == null || brutoPaineis == "") {
                        paineis = listOf<PainelFront>()
                    } else {
                        paineis = json.decode<List<PainelFront>>(brutoPaineis)
                    }
                    dados = listOf<List<Double> >()
                    status.text = "dashboard " + dash.title()
                    status.color = Palette.green

                    var novaSel = colunaPaineis(paineis, dados)
                    zonaPaineis.bind(novaSel)
                    colunas = listOf(novaSel)
                }
            }
        }
    })

    botaoAtualizar.on("click", (e: Event) -> {
        status.text = "atualizando ..."
        status.color = Palette.gray
        spawn {
            var bruto = await(http.get(base + "/api/dashboards"))
            var resumos = json.decode<List<DashboardResumoFront>>(bruto)
            var nomes = listOf<String>()
            for (var r in resumos) {
                nomes.add(r.name())
            }
            nomesDash = nomes
            seletorDash.setOptions(nomes)
            if (nomes.size > 0) {
                seletorDash.setSelected(0)
            }
            status.text = nomes.size.toString() + " dashboards em " + base
            status.color = Palette.green
        }
    })

    botaoAck.on("click", (e: Event) -> {
        var alvo = alvoDeAck(estadosAlerta)
        if (alvo != "") {
            status.text = "reconhecendo " + alvo + " ..."
            status.color = Palette.gray
            spawn {
                try {
                    await(http.post(base + "/api/alerts/" + alvo + "/ack", "{}"))
                    var bruto = await(http.get(base + "/api/alerts"))
                    estadosAlerta = json.decode<List<AlertaEstadoFront>>(bruto)
                    zonaAlertas.bind(colunaAlertas(estadosAlerta))
                    atualizarBotaoAck.run()
                    status.text = alvo + " reconhecido"
                    status.color = Palette.green
                } catch (String e2) {
                    status.text = "falha ao reconhecer: " + e2
                    status.color = Palette.red
                }
            }
        }
    })

    janela.show()
}
